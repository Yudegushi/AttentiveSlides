.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/
dist/
build/
*.egg-info/
.coverage
htmlcov/

# Local documentation scratch space. Track only durable public guides.
/docs/*
!/docs/deployment.md
!/docs/README_ASSET_CHECKLIST.md

# Local generated data and private study inputs.
/audio_eval/
/data/logs/
/data/live_decks/
/data/incoming/
/data/slide_images/
/data/slide_previews/
/data/uploaded_decks/
/data/calibration_profiles/
/data/study_reviews/
/data/gaze_reviews/
/data/aoi_manifest.json
/data/deck_metadata.json
/data/upload_index.json

data/audio_samples/*
!data/audio_samples/README.md
data/audio_eval/*
!data/audio_eval/README.md

# Generated evaluation reports and provider outputs.
/evaluation/output/
/evaluation/reports/
/evaluation/results/

# Model downloads and converted artifacts must remain external. These rules
# protect accidental project-local overrides without hiding source manifests.
/models/
/artifacts/
/data/models/
/data/artifacts/
*.part

# Local secrets and machine-specific settings
.env
.env.*
config.local.yaml
