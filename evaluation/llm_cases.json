      "case_id": "compare_fixation_saccade",
      "category": "compare",
      "description": "Compare two concepts using two slide sources.",
      "request": {
        "query_id": "eval_compare_001",
        "deck_id": "lecture_2",
        "slide_id": 2,
        "question": "fixation 和 saccade 有什么区别？",
        "intent": "compare",
        "response_mode": "compare",
        "confirmed_aoi_id": "aoi_fixation",
        "allow_external_knowledge": false,
        "response_language": "zh-CN",
        "sources": [
          {
            "source_id": "slide_02_aoi_01",
            "slide_id": 2,
            "source_kind": "confirmed_aoi",
            "aoi_id": "aoi_fixation",
            "text": "Fixation is maintaining gaze on a single location."
          },
          {
            "source_id": "slide_02_aoi_02",
            "slide_id": 2,
            "source_kind": "current_slide",
            "aoi_id": "aoi_saccade",
            "text": "Saccade is a rapid eye movement between fixations."
          }
        ]
      },
      "expectations": {
        "required_source_ids": [
          "slide_02_aoi_01",
          "slide_02_aoi_02"
        ],
        "forbidden_phrases": [
          "10–100",
          "10-100",
          "视觉系统几乎不处理"
        ],
        "min_direct_claims": 2
      },
      "fixture_response": {
        "response_mode": "compare",
        "answer": "Fixation 是保持视线在单一位置；Saccade 是 fixation 之间的快速眼动。",
        "decision_summary": "回答仅使用两个提供的 slide sources。",
        "claims": [
          {
            "claim": "Fixation 是保持视线在单一位置。",
            "support": "direct",
            "source_ids": [
              "slide_02_aoi_01"
            ]
          },
          {
            "claim": "Saccade 是 fixation 之间的快速眼动。",
            "support": "direct",
            "source_ids": [
              "slide_02_aoi_02"
            ]
          }
        ],
        "external_knowledge_used": false,
        "uncertainty_note": null,
        "active_recall_question": null
      }
    },
